{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firebase-config.example.js",
      "README.md",
      ".git/**",
      ".gitignore",
      "**/.*",
      "**/node_modules/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore-debug.log"
    ],
    "rewrites": [
      {
        "source": "/tasks/**",
        "destination": "/index.html"
      }
    ]
  }
}
